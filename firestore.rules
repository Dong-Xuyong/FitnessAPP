rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ElevateFit Security Rules
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function matchesPath(field, id) {
      return request.resource.data[field] == id;
    }

    // Helper to check if a field is being modified in an update
    function isFieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // Global Students Directory
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isOwner(studentId);
      allow update: if isOwner(studentId);
      allow delete: if false;
    }

    match /personalTrainers/{personalTrainerId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(personalTrainerId) && matchesPath('id', personalTrainerId);
      allow update: if isExistingOwner(personalTrainerId) && isFieldUnchanged('id');
      allow delete: if false;

      // Reusable training program templates (trainer library)
      match /trainingPrograms/{programId} {
        allow get, list: if isOwner(personalTrainerId);
        allow create: if isOwner(personalTrainerId)
          && request.resource.data.trainerId == personalTrainerId;
        allow update: if isOwner(personalTrainerId)
          && resource.data.trainerId == personalTrainerId
          && isFieldUnchanged('trainerId');
        allow delete: if isOwner(personalTrainerId)
          && resource.data.trainerId == personalTrainerId;
      }

      match /students/{studentId} {
        // Allow trainers to manage their students, and students to read/manage their own records
        allow get, list: if isOwner(personalTrainerId) || isOwner(studentId);
        
        allow create: if (isOwner(personalTrainerId) && matchesPath('trainerId', personalTrainerId)) || 
                      isOwner(studentId);
                      
        // Ensure trainerId cannot be changed once established
        allow update: if (isOwner(personalTrainerId) || isOwner(studentId)) && isFieldUnchanged('trainerId');
        
        allow delete: if isOwner(personalTrainerId);

        match /workoutPlans/{workoutPlanId} {
          allow get, list: if isOwner(personalTrainerId) || isOwner(studentId);
          allow create, update, delete: if isOwner(personalTrainerId);
        }

        match /workoutSessions/{workoutSessionId} {
          allow get, list: if isOwner(personalTrainerId) || isOwner(studentId);
          allow create, update: if isOwner(personalTrainerId) || isOwner(studentId);
          allow delete: if isOwner(personalTrainerId);
        }
      }
    }
  }
}
