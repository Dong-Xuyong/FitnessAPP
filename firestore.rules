
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * ElevateFit Security Rules
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function matchesPath(field, id) {
      return request.resource.data[field] == id;
    }

    function isImmutable(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /personalTrainers/{personalTrainerId} {
      allow get: if isSignedIn(); // Allow students to get trainer info for joining
      allow list: if isOwner(personalTrainerId);
      allow create: if isOwner(personalTrainerId) && matchesPath('id', personalTrainerId);
      allow update: if isExistingOwner(personalTrainerId) && isImmutable('id');
      allow delete: if false;

      match /students/{studentId} {
        // Allow access if user is the PT or if the student's email matches the auth token
        allow get, list: if isOwner(personalTrainerId) || (isSignedIn() && request.auth.token.email == resource.data.email);
        
        // PT can create student records OR students can join using a valid join code
        allow create: if (isOwner(personalTrainerId) && matchesPath('personalTrainerId', personalTrainerId)) || 
                      (isSignedIn() && request.auth.uid == studentId && 
                       request.resource.data.joinCode == get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)).data.joinCode);
        
        allow update: if (isOwner(personalTrainerId) || (isSignedIn() && request.auth.token.email == resource.data.email)) && isImmutable('personalTrainerId');
        allow delete: if isOwner(personalTrainerId);

        match /workoutPlans/{workoutPlanId} {
          allow get, list: if isOwner(personalTrainerId) || (isSignedIn() && request.auth.token.email == get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)).data.email);
          allow create: if isOwner(personalTrainerId);
          allow update: if isOwner(personalTrainerId);
          allow delete: if isOwner(personalTrainerId);
        }

        match /workoutSessions/{workoutSessionId} {
          allow get, list: if isOwner(personalTrainerId) || (isSignedIn() && request.auth.token.email == get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)).data.email);
          allow create: if isOwner(personalTrainerId) || (isSignedIn() && request.auth.token.email == get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)).data.email);
          allow update: if isOwner(personalTrainerId) || (isSignedIn() && request.auth.token.email == get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)).data.email);
          allow delete: if isOwner(personalTrainerId);
        }
      }
    }
  }
}
