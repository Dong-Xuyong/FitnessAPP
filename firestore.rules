rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Sergio Oliveira PT Security Rules
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isTrainer() {
      return isSignedIn() && exists(/databases/$(database)/documents/personalTrainers/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function matchesPath(field, id) {
      return request.resource.data[field] == id;
    }

    // Helper to check if a field is being modified in an update
    function isFieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    // Allows a student to access trainer subcollection data stored under a different doc ID
    // (rosterDocId) by verifying it via their global student profile.
    function isLinkedStudent(personalTrainerId, studentId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.rosterDocId == studentId &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.trainerId == personalTrainerId;
    }

    /**
     * True when the signed-in user may access personalTrainers/{tid}/students/{studentPathId}/...
     * Path id is auth.uid, or rosterDocId on global students/{auth.uid} matches studentPathId.
     */
    function canStudentAccessTrainerStudentPath(personalTrainerId, studentPathId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.trainerId == personalTrainerId &&
        (
          request.auth.uid == studentPathId ||
          (
            ('rosterDocId' in get(/databases/$(database)/documents/students/$(request.auth.uid)).data) &&
            get(/databases/$(database)/documents/students/$(request.auth.uid)).data.rosterDocId is string &&
            get(/databases/$(database)/documents/students/$(request.auth.uid)).data.rosterDocId == studentPathId
          )
        );
    }

    function isStudentOfTrainer(personalTrainerId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.trainerId == personalTrainerId;
    }

    /** Linked student (roster doc id) may merge only weight / body fat on their roster record. */
    function linkedStudentBodyMetricsMerge(personalTrainerId, studentId) {
      return canStudentAccessTrainerStudentPath(personalTrainerId, studentId) &&
        request.auth.uid != studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weightKg', 'bodyFatPercent']);
    }

    function completedAtWriteValid() {
      return (request.resource.data.completedAt is string) ||
        (request.resource.data.completedAt is timestamp);
    }

    /** Student finishes a workout: only completion fields may be added or changed on workoutPlans. */
    function studentMarkingWorkoutPlanComplete(personalTrainerId, studentId) {
      return (
        canStudentAccessTrainerStudentPath(personalTrainerId, studentId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedAt', 'status']) &&
        request.resource.data.status == 'completed' &&
        completedAtWriteValid()
      );
    }

    /** Prior plan in a sequence is finished (status and/or completedAt). */
    function priorPlanFinishedForSequenceUnlock(personalTrainerId, studentId, priorPlanId) {
      return priorPlanId is string &&
        exists(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)/workoutPlans/$(priorPlanId)) &&
        (
          get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)/workoutPlans/$(priorPlanId)).data.status == 'completed' ||
          ('completedAt' in get(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)/workoutPlans/$(priorPlanId)).data)
        );
    }

    function shopLineQtyValid(qty) {
      return (
        (qty is int && qty >= 0 && qty <= 999) ||
        (qty is float && qty >= 0 && qty <= 999 && int(qty) == qty)
      );
    }

    function shopLineElementValid(line) {
      return line.keys().hasOnly(['itemId', 'quantity']) &&
        line.itemId is string &&
        line.itemId.size() > 0 &&
        line.itemId.size() <= 128 &&
        shopLineQtyValid(line.quantity);
    }

    function shopLinesListValid(lines) {
      return lines is list &&
        lines.size() <= 20 &&
        (lines.size() < 1 || shopLineElementValid(lines[0])) &&
        (lines.size() < 2 || shopLineElementValid(lines[1])) &&
        (lines.size() < 3 || shopLineElementValid(lines[2])) &&
        (lines.size() < 4 || shopLineElementValid(lines[3])) &&
        (lines.size() < 5 || shopLineElementValid(lines[4])) &&
        (lines.size() < 6 || shopLineElementValid(lines[5])) &&
        (lines.size() < 7 || shopLineElementValid(lines[6])) &&
        (lines.size() < 8 || shopLineElementValid(lines[7])) &&
        (lines.size() < 9 || shopLineElementValid(lines[8])) &&
        (lines.size() < 10 || shopLineElementValid(lines[9])) &&
        (lines.size() < 11 || shopLineElementValid(lines[10])) &&
        (lines.size() < 12 || shopLineElementValid(lines[11])) &&
        (lines.size() < 13 || shopLineElementValid(lines[12])) &&
        (lines.size() < 14 || shopLineElementValid(lines[13])) &&
        (lines.size() < 15 || shopLineElementValid(lines[14])) &&
        (lines.size() < 16 || shopLineElementValid(lines[15])) &&
        (lines.size() < 17 || shopLineElementValid(lines[16])) &&
        (lines.size() < 18 || shopLineElementValid(lines[17])) &&
        (lines.size() < 19 || shopLineElementValid(lines[18])) &&
        (lines.size() < 20 || shopLineElementValid(lines[19]));
    }

    function shopBillingStatusValid(status) {
      return status == 'unpaid' || status == 'paid';
    }

    /** Lines with optional billing fields (coach mark-paid, student unpaid merge). */
    function shopBillableLineElementValid(line) {
      return line.itemId is string &&
        line.itemId.size() > 0 &&
        line.itemId.size() <= 128 &&
        shopLineQtyValid(line.quantity) &&
        (
          (
            line.keys().hasOnly(['itemId', 'quantity', 'billingStatus']) &&
            line.billingStatus is string &&
            shopBillingStatusValid(line.billingStatus)
          ) ||
          (
            line.keys().hasOnly(['itemId', 'quantity', 'billingStatus', 'paidInPaymentId']) &&
            line.billingStatus is string &&
            shopBillingStatusValid(line.billingStatus) &&
            line.paidInPaymentId is string &&
            line.paidInPaymentId.size() <= 128
          )
        );
    }

    function shopBillableLinesListValid(lines) {
      return lines is list &&
        lines.size() <= 20 &&
        (lines.size() < 1 || shopBillableLineElementValid(lines[0])) &&
        (lines.size() < 2 || shopBillableLineElementValid(lines[1])) &&
        (lines.size() < 3 || shopBillableLineElementValid(lines[2])) &&
        (lines.size() < 4 || shopBillableLineElementValid(lines[3])) &&
        (lines.size() < 5 || shopBillableLineElementValid(lines[4])) &&
        (lines.size() < 6 || shopBillableLineElementValid(lines[5])) &&
        (lines.size() < 7 || shopBillableLineElementValid(lines[6])) &&
        (lines.size() < 8 || shopBillableLineElementValid(lines[7])) &&
        (lines.size() < 9 || shopBillableLineElementValid(lines[8])) &&
        (lines.size() < 10 || shopBillableLineElementValid(lines[9])) &&
        (lines.size() < 11 || shopBillableLineElementValid(lines[10])) &&
        (lines.size() < 12 || shopBillableLineElementValid(lines[11])) &&
        (lines.size() < 13 || shopBillableLineElementValid(lines[12])) &&
        (lines.size() < 14 || shopBillableLineElementValid(lines[13])) &&
        (lines.size() < 15 || shopBillableLineElementValid(lines[14])) &&
        (lines.size() < 16 || shopBillableLineElementValid(lines[15])) &&
        (lines.size() < 17 || shopBillableLineElementValid(lines[16])) &&
        (lines.size() < 18 || shopBillableLineElementValid(lines[17])) &&
        (lines.size() < 19 || shopBillableLineElementValid(lines[18])) &&
        (lines.size() < 20 || shopBillableLineElementValid(lines[19]));
    }

    /** Student may write unpaid billable lines or preserve existing paid rows. */
    function shopStudentLineElementValid(line) {
      return shopLineElementValid(line) ||
        (
          line.keys().hasOnly(['itemId', 'quantity', 'billingStatus']) &&
          line.billingStatus == 'unpaid' &&
          line.itemId is string &&
          line.itemId.size() > 0 &&
          line.itemId.size() <= 128 &&
          shopLineQtyValid(line.quantity)
        ) ||
        (
          line.keys().hasOnly(['itemId', 'quantity', 'billingStatus']) &&
          line.billingStatus == 'paid' &&
          line.itemId is string &&
          line.itemId.size() > 0 &&
          line.itemId.size() <= 128 &&
          shopLineQtyValid(line.quantity)
        ) ||
        (
          line.keys().hasOnly(['itemId', 'quantity', 'billingStatus', 'paidInPaymentId']) &&
          line.billingStatus == 'paid' &&
          line.itemId is string &&
          line.itemId.size() > 0 &&
          line.itemId.size() <= 128 &&
          shopLineQtyValid(line.quantity) &&
          line.paidInPaymentId is string &&
          line.paidInPaymentId.size() > 0 &&
          line.paidInPaymentId.size() <= 128
        );
    }

    function shopSubRegistrationPayloadKeysValid() {
      return request.resource.data.keys().hasOnly(['studentId', 'trainerId', 'date', 'time', 'itemId', 'quantity', 'billingStatus', 'updatedAt']);
    }

    function shopPurchaseItemIdValid(itemId) {
      return itemId is string && itemId.size() > 0 && itemId.size() <= 128;
    }

    function shopRegistrationTimeValid(time) {
      return time is string && time.matches('^[0-9]{2}:[0-9]{2}:[0-9]{2}$');
    }

    function shopSubStudentOwnsPurchase(personalTrainerId) {
      return canStudentAccessTrainerStudentPath(personalTrainerId, resource.data.studentId);
    }

    function shopSubStudentCreateValid(personalTrainerId, regId) {
      return isSignedIn() &&
        shopSubStudentLinkedToTrainer(personalTrainerId) &&
        canStudentAccessTrainerStudentPath(personalTrainerId, request.auth.uid) &&
        shopSubRegistrationPayloadKeysValid() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.trainerId == personalTrainerId &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        shopRegistrationTimeValid(request.resource.data.time) &&
        shopPurchaseItemIdValid(request.resource.data.itemId) &&
        shopLineQtyValid(request.resource.data.quantity) &&
        request.resource.data.billingStatus == 'unpaid' &&
        (
          (request.resource.data.updatedAt is string) ||
          (request.resource.data.updatedAt is timestamp)
        );
    }

    /** Coach registers a purchase for a student on their roster (auth uid or roster doc id). */
    function coachShopStudentIdOnRoster(personalTrainerId, studentId) {
      return studentId is string &&
        studentId.size() > 0 &&
        studentId.size() <= 128 &&
        (
          exists(/databases/$(database)/documents/personalTrainers/$(personalTrainerId)/students/$(studentId)) ||
          (
            exists(/databases/$(database)/documents/students/$(studentId)) &&
            get(/databases/$(database)/documents/students/$(studentId)).data.trainerId == personalTrainerId
          )
        );
    }

    function shopSubCoachCreateValid(personalTrainerId) {
      return isOwner(personalTrainerId) &&
        shopSubRegistrationPayloadKeysValid() &&
        request.resource.data.trainerId == personalTrainerId &&
        coachShopStudentIdOnRoster(personalTrainerId, request.resource.data.studentId) &&
        request.resource.data.date is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        shopRegistrationTimeValid(request.resource.data.time) &&
        shopPurchaseItemIdValid(request.resource.data.itemId) &&
        shopLineQtyValid(request.resource.data.quantity) &&
        request.resource.data.billingStatus == 'unpaid' &&
        (
          (request.resource.data.updatedAt is string) ||
          (request.resource.data.updatedAt is timestamp)
        );
    }

    function shopSubCoachBillingUpdateValid(personalTrainerId) {
      return isOwner(personalTrainerId) &&
        resource != null &&
        resource.data.trainerId == personalTrainerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['billingStatus', 'paidInPaymentId', 'updatedAt']) &&
        isFieldUnchanged('studentId') &&
        isFieldUnchanged('trainerId') &&
        isFieldUnchanged('date') &&
        isFieldUnchanged('time') &&
        isFieldUnchanged('itemId') &&
        isFieldUnchanged('quantity') &&
        (
          request.resource.data.billingStatus == 'paid' ||
          request.resource.data.billingStatus == 'unpaid'
        ) &&
        (
          (request.resource.data.updatedAt is string) ||
          (request.resource.data.updatedAt is timestamp)
        );
    }

    function shopStudentLinesListValid(lines) {
      return lines is list &&
        lines.size() <= 20 &&
        (lines.size() < 1 || shopStudentLineElementValid(lines[0])) &&
        (lines.size() < 2 || shopStudentLineElementValid(lines[1])) &&
        (lines.size() < 3 || shopStudentLineElementValid(lines[2])) &&
        (lines.size() < 4 || shopStudentLineElementValid(lines[3])) &&
        (lines.size() < 5 || shopStudentLineElementValid(lines[4])) &&
        (lines.size() < 6 || shopStudentLineElementValid(lines[5])) &&
        (lines.size() < 7 || shopStudentLineElementValid(lines[6])) &&
        (lines.size() < 8 || shopStudentLineElementValid(lines[7])) &&
        (lines.size() < 9 || shopStudentLineElementValid(lines[8])) &&
        (lines.size() < 10 || shopStudentLineElementValid(lines[9])) &&
        (lines.size() < 11 || shopStudentLineElementValid(lines[10])) &&
        (lines.size() < 12 || shopStudentLineElementValid(lines[11])) &&
        (lines.size() < 13 || shopStudentLineElementValid(lines[12])) &&
        (lines.size() < 14 || shopStudentLineElementValid(lines[13])) &&
        (lines.size() < 15 || shopStudentLineElementValid(lines[14])) &&
        (lines.size() < 16 || shopStudentLineElementValid(lines[15])) &&
        (lines.size() < 17 || shopStudentLineElementValid(lines[16])) &&
        (lines.size() < 18 || shopStudentLineElementValid(lines[17])) &&
        (lines.size() < 19 || shopStudentLineElementValid(lines[18])) &&
        (lines.size() < 20 || shopStudentLineElementValid(lines[19]));
    }

    function shopItemPriceValid(price) {
      return price is number && price >= 0 && price <= 9999;
    }

    function shopItemWriteValid() {
      return request.resource.data.keys().hasOnly(['name', 'price', 'active', 'createdAt', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        shopItemPriceValid(request.resource.data.price) &&
        request.resource.data.active is bool &&
        (
          (request.resource.data.createdAt is string) ||
          (request.resource.data.createdAt is timestamp)
        ) &&
        (
          (request.resource.data.updatedAt is string) ||
          (request.resource.data.updatedAt is timestamp)
        );
    }

    /** @deprecated Legacy day-grouped docs; migration removes these. */
    function shopSubRegDocIdForStudent(regId) {
      return regId.matches('^' + request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function shopSubStudentLinkedToTrainer(personalTrainerId) {
      return exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.trainerId == personalTrainerId;
    }

    /** Legacy update path removed — purchases are append-only for students. */
    function shopSubStudentUpdateValid(personalTrainerId, regId) {
      return false;
    }

    /** Student unlocks the next step in a sequence (only `studentUnlocked` false → true). */
    function studentUnlockingSequenceStep(personalTrainerId, studentId) {
      return (
        canStudentAccessTrainerStudentPath(personalTrainerId, studentId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentUnlocked']) &&
        resource.data.sequenceUnlockAfterPlanId is string &&
        (
          resource.data.get('studentUnlocked', false) == false ||
          (('studentUnlocked' in resource.data) && resource.data.studentUnlocked == null)
        ) &&
        request.resource.data.studentUnlocked == true &&
        priorPlanFinishedForSequenceUnlock(
          personalTrainerId,
          studentId,
          resource.data.sequenceUnlockAfterPlanId
        )
      );
    }

    // Global Exercises Library
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow create: if isTrainer();
      allow update: if isTrainer() && resource.data.createdBy == request.auth.uid;
      allow delete: if isTrainer() && (
        resource.data.createdBy == request.auth.uid || 
        !(resource.data.createdBy is string)
      );
    }

    // Global Students Directory
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isOwner(studentId);
      // Trainers can update to set trainerId / rosterDocId linking fields.
      // Students may update their profile but not `blocked` / `blockedReason` (coach or Admin SDK only).
      allow update: if isTrainer() || (isOwner(studentId) && isFieldUnchanged('blocked') && isFieldUnchanged('blockedReason'));
      allow delete: if false;
    }

    // Milestones Collection
    match /milestones/{milestoneId} {
      // Trainer owns by trainerId; student matches doc studentId via auth.uid OR rosterDocId (see helper).
      allow get: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid ||
        canStudentAccessTrainerStudentPath(resource.data.trainerId, resource.data.studentId)
      );

      allow list: if isSignedIn() && (
        resource.data.trainerId == request.auth.uid ||
        canStudentAccessTrainerStudentPath(resource.data.trainerId, resource.data.studentId)
      );

      allow create: if (isTrainer() &&
        request.resource.data.trainerId == request.auth.uid &&
        request.resource.data.studentId != null) ||
        (
          request.resource.data.studentId == request.auth.uid &&
          canStudentAccessTrainerStudentPath(
            request.resource.data.trainerId,
            request.resource.data.studentId
          )
        );

      allow update: if (isTrainer() &&
        resource.data.trainerId == request.auth.uid &&
        request.resource.data.trainerId == resource.data.trainerId) ||
        (
          canStudentAccessTrainerStudentPath(resource.data.trainerId, resource.data.studentId) &&
          request.resource.data.studentId == resource.data.studentId &&
          request.resource.data.trainerId == resource.data.trainerId
        );

      allow delete: if (isTrainer() &&
        resource.data.trainerId == request.auth.uid) ||
        canStudentAccessTrainerStudentPath(resource.data.trainerId, resource.data.studentId);
    }

    match /personalTrainers/{personalTrainerId} {
    
      match /personalTrainingPrograms/{programId} {
        allow get, list: if isOwner(personalTrainerId);
        allow create, update, delete: if isOwner(personalTrainerId);
      }	

      // Students may update slots to book/unbook; ideally `sessionAttendance` / `sessionAttendanceAt`
      // would be trainer-only (requires tighter validation or Cloud Functions). Client sets booking only.
      match /sessionSlots/{slotId} {
        allow get, list: if isOwner(personalTrainerId) || isStudentOfTrainer(personalTrainerId);
        allow create, update, delete: if isOwner(personalTrainerId) || isStudentOfTrainer(personalTrainerId);
      }

      match /weekProgramAssignments/{assignmentId} {
        allow get, list: if isOwner(personalTrainerId) || isStudentOfTrainer(personalTrainerId);
        allow create, update, delete: if isOwner(personalTrainerId);
      }

      // Trainer catalog items; coach (owner) and linked students may read.
      match /shopItems/{itemId} {
        allow get, list: if isOwner(personalTrainerId) || isStudentOfTrainer(personalTrainerId);
        allow create: if isOwner(personalTrainerId) && shopItemWriteValid();
        allow update: if isOwner(personalTrainerId) && shopItemWriteValid();
        allow delete: if isOwner(personalTrainerId);
      }

      // Gym shop registrations: under trainer path so coach list uses isOwner (reliable vs top-level queries).
      match /shopRegistrations/{regId} {
        allow list: if isOwner(personalTrainerId) ||
          (
            isSignedIn() &&
            shopSubStudentLinkedToTrainer(personalTrainerId) &&
            canStudentAccessTrainerStudentPath(personalTrainerId, resource.data.studentId)
          );

        allow get: if isOwner(personalTrainerId) ||
          (
            isSignedIn() &&
            resource != null &&
            shopSubStudentOwnsPurchase(personalTrainerId) &&
            shopSubStudentLinkedToTrainer(personalTrainerId)
          );

        allow create: if shopSubStudentCreateValid(personalTrainerId, regId) ||
          shopSubCoachCreateValid(personalTrainerId);
        allow update: if shopSubCoachBillingUpdateValid(personalTrainerId);
        allow delete: if isOwner(personalTrainerId);
      }
    
      allow get, list: if isSignedIn();
      allow create: if isOwner(personalTrainerId) && matchesPath('id', personalTrainerId);
      allow update: if isExistingOwner(personalTrainerId) && isFieldUnchanged('id');
      allow delete: if false;

      match /students/{studentId} {
        // Allow trainers to manage their students, and students to read/manage their own records
        allow get, list: if isOwner(personalTrainerId) || isOwner(studentId) || isLinkedStudent(personalTrainerId, studentId);
        
        allow create: if (isOwner(personalTrainerId) && matchesPath('trainerId', personalTrainerId)) || 
                      isOwner(studentId);
                      
        // Ensure trainerId cannot be changed once established.
        // Linked students may not change `blocked` / `blockedReason` on the roster doc.
        allow update: if (isFieldUnchanged('trainerId')) && (
          isOwner(personalTrainerId) ||
          (isOwner(studentId) && isFieldUnchanged('blocked') && isFieldUnchanged('blockedReason')) ||
          linkedStudentBodyMetricsMerge(personalTrainerId, studentId)
        );
        
        allow delete: if isOwner(personalTrainerId);

        match /workoutPlans/{workoutPlanId} {
          allow get, list: if isOwner(personalTrainerId) || isOwner(studentId) || isLinkedStudent(personalTrainerId, studentId);
          allow create: if isOwner(personalTrainerId);
          allow update: if isOwner(personalTrainerId) ||
            studentMarkingWorkoutPlanComplete(personalTrainerId, studentId) ||
            studentUnlockingSequenceStep(personalTrainerId, studentId);
          allow delete: if isOwner(personalTrainerId) || isOwner(studentId) || isLinkedStudent(personalTrainerId, studentId);
        }

        match /workoutSessions/{workoutSessionId} {
          allow get, list: if isOwner(personalTrainerId) || canStudentAccessTrainerStudentPath(personalTrainerId, studentId);
          allow create, update: if isOwner(personalTrainerId) || canStudentAccessTrainerStudentPath(personalTrainerId, studentId);
          allow delete: if isOwner(personalTrainerId) ||
            canStudentAccessTrainerStudentPath(personalTrainerId, studentId);
        }

        match /payments/{paymentId} {
          allow get, list: if isOwner(personalTrainerId) || isOwner(studentId) || isLinkedStudent(personalTrainerId, studentId);
          allow create, update, delete: if isOwner(personalTrainerId);
        }
      }
    }
  }
}
