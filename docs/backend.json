
{
  "entities": {
    "PersonalTrainer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PersonalTrainer",
      "type": "object",
      "description": "Represents a personal trainer.",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoUrl": { "type": "string" },
        "dateJoined": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "firstName", "lastName", "email", "dateJoined"]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student client with detailed fitness metrics.",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID" },
        "trainerId": { "type": "string", "description": "ID of the assigned trainer" },
        "name": { "type": "string", "description": "Full name of the student" },
        "email": { "type": "string", "format": "email" },
        "photoUrl": { "type": "string" },
        "age": { "type": "number" },
        "sex": { "type": "string", "enum": ["male", "female", "other"] },
        "weightKg": { "type": "number" },
        "heightCm": { "type": "number" },
        "goalType": { "type": "string" },
        "goalWeightKg": { "type": "number" },
        "activityStatus": { "type": "string", "enum": ["active", "inactive"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "currentProgramId": { "type": "string" },
        "subscriptionStatus": { "type": "string", "enum": ["active", "expired", "pending"] },
        "currentStreakDays": { "type": "number" },
        "lastWorkoutAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "email"]
    }
  },
  "auth": {
    "providers": ["password", "google.com", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/personalTrainers/{personalTrainerId}",
        "definition": {
          "entityName": "PersonalTrainer",
          "schema": { "$ref": "#/backend/entities/PersonalTrainer" },
          "description": "Trainer profiles."
        }
      },
      {
        "path": "/personalTrainers/{personalTrainerId}/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": { "$ref": "#/backend/entities/Student" },
          "description": "Students managed by specific trainers."
        }
      },
      {
        "path": "/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": { "$ref": "#/backend/entities/Student" },
          "description": "Global directory of student profiles."
        }
      }
    ]
  }
}
