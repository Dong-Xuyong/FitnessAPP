
{
  "entities": {
    "PersonalTrainer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PersonalTrainer",
      "type": "object",
      "description": "Represents a personal trainer who uses the ElevateFit platform to manage students and workouts.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the PersonalTrainer entity."
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the personal trainer."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the personal trainer."
        },
        "email": {
          "type": "string",
          "description": "The email address of the personal trainer, used for communication.",
          "format": "email"
        },
        "dateJoined": {
          "type": "string",
          "description": "The date and time when the trainer account was created.",
          "format": "date-time"
        },
        "joinCode": {
          "type": "string",
          "description": "A unique code students can use to join this trainer's roster."
        }
      },
      "required": [
        "id",
        "firstName",
        "lastName",
        "email",
        "dateJoined"
      ]
    },
    "Student": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Student",
      "type": "object",
      "description": "Represents a student client managed by a personal trainer on the ElevateFit platform.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Student entity."
        },
        "personalTrainerId": {
          "type": "string",
          "description": "Reference to the PersonalTrainer managing this student."
        },
        "userId": {
          "type": "string",
          "description": "The Auth UID of the student if they have registered."
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the student."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the student."
        },
        "email": {
          "type": "string",
          "description": "The email address of the student.",
          "format": "email"
        },
        "password": {
          "type": "string",
          "description": "Initial password assigned by the trainer."
        },
        "age": {
          "type": "number",
          "description": "The age of the student."
        },
        "sex": {
          "type": "string",
          "enum": ["male", "female", "other"]
        },
        "weightKg": {
          "type": "number",
          "description": "Current weight in kilograms."
        },
        "heightCm": {
          "type": "number",
          "description": "Height in centimeters."
        },
        "goalType": {
          "type": "string",
          "description": "Primary goal (e.g., muscle_gain, weight_loss)."
        },
        "goalWeightKg": {
          "type": "number",
          "description": "Target weight in kilograms."
        },
        "activityStatus": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "currentProgramId": {
          "type": "string"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "expired", "pending"]
        },
        "currentStreakDays": {
          "type": "number"
        },
        "lastWorkoutAt": {
          "type": "string",
          "format": "date-time"
        },
        "joinCode": {
          "type": "string",
          "description": "The code used to link to the trainer (transient)."
        }
      },
      "required": [
        "personalTrainerId",
        "firstName",
        "lastName",
        "email",
        "age",
        "joinedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "google.com",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/personalTrainers/{personalTrainerId}",
        "definition": {
          "entityName": "PersonalTrainer",
          "schema": {
            "$ref": "#/backend/entities/PersonalTrainer"
          },
          "description": "Trainer profiles."
        }
      },
      {
        "path": "/personalTrainers/{personalTrainerId}/students/{studentId}",
        "definition": {
          "entityName": "Student",
          "schema": {
            "$ref": "#/backend/entities/Student"
          },
          "description": "Students managed by trainers."
        }
      }
    ]
  }
}
